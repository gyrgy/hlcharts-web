{
  "name": "hlcharts-web",
  "version": "0.1.0",
  "private": true,
  "description": "hlcharts.com website, phase 1 (live numbers from Hyperliquid only). Lives in coin-trader's web/ until it moves to its own repository before release; nothing here imports from ../src.",
  "scripts": {
    "dev": "mkdir -p .tmp && TMPDIR=$PWD/.tmp NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "mkdir -p .tmp && TMPDIR=$PWD/.tmp NEXT_TELEMETRY_DISABLED=1 NODE_USE_ENV_PROXY=1 next build",
    "typecheck": "tsc --noEmit",
    "test": "mkdir -p .tmp && TMPDIR=$PWD/.tmp vitest run",
    "check-pages": "mkdir -p .tmp && TMPDIR=$PWD/.tmp node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "geist": "1.7.2",
    "lucide-react": "1.53.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "postcss": "8.5.30",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
